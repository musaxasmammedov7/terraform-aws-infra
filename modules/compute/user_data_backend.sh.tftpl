#!/bin/bash
# user_data for BACKEND API instances.
# Starts a minimal HTTP server on port 80 (answers /api/health too) so ALB
# health checks pass. Replace the server with your real backend later - DB,
# S3, SQS and secret values are available via SSM/Secrets Manager.
set -uo pipefail
exec > >(tee /var/log/user-data.log | logger -t user-data) 2>&1

PROJECT="${project}"
ENV="${environment}"
REGION="${region}"

# Read runtime config from SSM Parameter Store (non-secret values).
RDS_HOST=$(aws ssm get-parameter --name "/$${PROJECT}/$${ENV}/rds/host" --region "$REGION" --query Parameter.Value --output text 2>/dev/null || true)
RDS_PORT=$(aws ssm get-parameter --name "/$${PROJECT}/$${ENV}/rds/port" --region "$REGION" --query Parameter.Value --output text 2>/dev/null || true)
S3_BUCKET=$(aws ssm get-parameter --name "/$${PROJECT}/$${ENV}/s3/bucket" --region "$REGION" --query Parameter.Value --output text 2>/dev/null || true)
SQS_URL=$(aws ssm get-parameter --name "/$${PROJECT}/$${ENV}/sqs/url" --region "$REGION" --query Parameter.Value --output text 2>/dev/null || true)
SECRET_ARN=$(aws ssm get-parameter --name "/$${PROJECT}/$${ENV}/secrets/app" --region "$REGION" --query Parameter.Value --output text 2>/dev/null || true)

export RDS_HOST RDS_PORT S3_BUCKET SQS_URL SECRET_ARN

# Minimal HTTP 200 server (replace with your real backend server)
python3 - <<'PY' &
from http.server import BaseHTTPRequestHandler, HTTPServer

class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        self.send_response(200)
        self.end_headers()
        self.wfile.write(b'OK from backend (' + self.path.encode() + b')')
    def log_message(self, *args):
        pass

HTTPServer(('0.0.0.0', 80), Handler).serve_forever()
PY

echo "Backend instance bootstrapped: $HOSTNAME (env=$ENV)"