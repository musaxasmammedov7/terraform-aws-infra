#!/bin/bash
# user_data for FRONTEND instances.
# Reads runtime configuration from SSM Parameter Store and starts the app.
set -euo pipefail
exec > >(tee /var/log/user-data.log | logger -t user-data) 2>&1

PROJECT="${project}"
ENV="${environment}"
REGION="${region}"

S3_BUCKET=$(aws ssm get-parameter --name "/$${PROJECT}/$${ENV}/s3/bucket" --region "$REGION" --query Parameter.Value --output text)
export S3_BUCKET

dnf update -y

# ---- Replace the following with your real frontend start command: ----
# cd /opt/frontend && ./frontend-server --bind 0.0.0.0:80
echo "Frontend instance bootstrapped: $HOSTNAME (env=$ENV)"